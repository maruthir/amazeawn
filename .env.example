# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# --- Admin persona (seeded at startup) ---
ADMIN_EMAIL=admin@amazeawn.local
ADMIN_PASSWORD=admin123

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
AUTH_BCRYPT_COST=10          # lower (4-6) to keep signup/login cheap in load runs

# --- Seed data ---
CATALOG_SIZE=500
INITIAL_STOCK=1000
CATALOG_CATEGORIES=8

# --- Payment simulator (processor) ---
PAYMENT_LATENCY_MS=50
PAYMENT_LATENCY_JITTER_MS=50
PAYMENT_FAILURE_RATE=0.05    # 0.0 for no random declines; cards 4242... always approve, 4000...0002 always decline

# --- Fulfilment timers ---
FULFILMENT_ENABLED=true
FULFILMENT_SHIP_AFTER=PT30S
FULFILMENT_DELIVER_AFTER=PT60S

# --- Rate limiting (off by default) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- Scale knobs (laptop defaults; raise for a server) ---
API_DB_POOL_SIZE=16
API_HTTP_MAX_THREADS=200
API_CONSUMER_CONCURRENCY=4
PROCESSOR_DB_POOL_SIZE=12
PROCESSOR_CONSUMER_CONCURRENCY=8
CONSUMER_PREFETCH=20
OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=200
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=256MB
API_MEMORY=1g
PROCESSOR_MEMORY=768m

# --- Profiles ---
# "loadtest" enables POST /api/v1/test/reset. Set to "" (empty) to disable it.
API_PROFILES=loadtest

# --- Host ports ---
API_PORT=8080
POSTGRES_PORT=5433             # host port for psql access; containers use 5432 internally
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
