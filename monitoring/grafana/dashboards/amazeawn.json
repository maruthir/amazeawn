{
  "title": "Amazeawn overview",
  "uid": "amazeawn-overview",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests/s by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"amazeawn-api\"}[1m]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP p95 latency (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"amazeawn-api\"}[1m])))", "legendFormat": "{{uri}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Orders placed/s vs outcomes/s",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(amazeawn_orders_placed_total[1m]))", "legendFormat": "placed" },
        { "expr": "sum by (outcome) (rate(amazeawn_orders_outcome_total[1m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Outbox pending rows",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "amazeawn_outbox_pending", "legendFormat": "{{application}} {{instance}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Consumer retries and dead letters/s",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (queue) (rate(amazeawn_consumer_retried_total[1m]))", "legendFormat": "retried {{queue}}" },
        { "expr": "sum by (queue) (rate(amazeawn_consumer_dead_lettered_total[1m]))", "legendFormat": "dead-lettered {{queue}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Payment charge p95 (s)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(amazeawn_payment_charge_seconds_bucket[1m])))", "legendFormat": "p95" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Hikari active connections",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [{ "expr": "hikaricp_connections_active", "legendFormat": "{{application}} {{instance}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "JVM heap used (MB)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (application, instance) (jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024", "legendFormat": "{{application}} {{instance}}" }]
    }
  ]
}
